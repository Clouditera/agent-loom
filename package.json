{
  "name": "agent-loom",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Clouditera/agent-loom.git"
  },
  "description": "A lightweight agent workflow SDK based on the pi SDK — session context reuse, parallel pools, resumable runs",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p .",
    "example:context": "node examples/01-context.ts",
    "example:relay": "node examples/02-relay.ts --fresh"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ]
}
